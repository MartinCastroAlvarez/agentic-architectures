# Copy to .env (never commit it). Every variable is optional.
AGENTIC_PROVIDER=ollama                 # ollama | openai | fake
AGENTIC_MODEL=qwen3:4b
OLLAMA_HOST=http://127.0.0.1:11434      # loopback only unless the next line is 1
AGENTIC_ALLOW_REMOTE=
AGENTIC_TEMPERATURE=0
AGENTIC_FAKE_LATENCY=0
# Only for the optional OpenAI-compatible adapter (vLLM, llama.cpp server, LM Studio, or a hosted API):
# OPENAI_BASE_URL=http://127.0.0.1:8000/v1
# OPENAI_API_KEY=
